<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cockpit_black">

    <!-- Direction A: IWC-Inspired Mechanical Analog Watch View -->
    <com.mercedes.minimalclock.IwcAnalogClockView
        android:id="@+id/analogClockView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- Direction B: Mercedes Minimal Digital Instrument View -->
    <com.mercedes.minimalclock.MercedesDigitalClockView
        android:id="@+id/digitalClockView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <com.mercedes.minimalclock.TelemetryView
        android:id="@+id/telemetryView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Top Right Gear Settings Button -->
    <ImageButton
        android:id="@+id/btnSettingsGear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_settings_gear"
        android:contentDescription="@string/settings_action"
        android:padding="10dp"
        android:elevation="4dp" />

</FrameLayout>
